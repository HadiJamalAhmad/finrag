# SEC requires a name and a contact address for automated access.
SEC_USER_AGENT="Your Name your.email@example.com"
# OLLAMA_URL=http://localhost:11434
# FINRAG_MODEL=llama-3b   # llama-3b | qwen3-4b | mistral-24b (src/finrag/models.py)
# FINRAG_GPU=L4            # for the cost estimate
# FINRAG_MIN_SCORE=0.72
# Hosted models (opt-in: the question and retrieved passages go to the vendor).
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# Tracing, Langfuse Cloud EU (cloud.langfuse.com > project > API keys).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # EU (the default)
# FINRAG_ENV=development   # Langfuse environment: development | production | eval
# Push them to Modal with: uv run python deploy/push_secrets.py

# Copy to deploy/oracle/.env on the VM and fill. Never commit .env (gitignored).
# Use the same FINRAG_API_KEY as in the Vercel project settings.

# Free HTTPS name for the VM's public IP, e.g. 141-145-12-34.sslip.io
DOMAIN=

FINRAG_API_KEY=
FINRAG_INGEST_KEY=

# Sign-in (same values as on Modal)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
FINRAG_SITE_ORIGINS=https://finrag-ten.vercel.app

# Optional: traces, and the hosted models (fast; billed per token by the vendor)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
